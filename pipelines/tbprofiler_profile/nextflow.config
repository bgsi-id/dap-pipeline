manifest {
    name = 'DAP TB-Profiler profiling'
    version = '0.1.0'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.10.0'
}

// TB-Profiler's biocontainer is public and pinned directly here. Unlike the
// private per-deployment images used by other pipelines, no runtime
// injection is required to keep this image trusted.
params.tbprofiler_image = 'quay.io/biocontainers/tb-profiler:3.0.8--pypyh5e36f6f_0'

process {
    errorStrategy = 'terminate'
}

profiles {
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled = true
    }
}

report { enabled = true; file = 'nextflow-report.html' }
timeline { enabled = true; file = 'nextflow-timeline.html' }
trace { enabled = true; file = 'nextflow-trace.tsv' }
dag { enabled = true; file = 'nextflow-dag.html' }
