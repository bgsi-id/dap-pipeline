plugins {
    id 'nf-amazon@3.9.2'
}

manifest {
    name = 'DAP variant ETL'
    version = '0.2.6'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.10.0'
}

// The ingestion image may live in a private deployment registry. Keep that
// deployment concern out of this public repository; dap-runtime injects it.
params.variant_image = null
params.bcftools_image = 'quay.io/biocontainers/bcftools:1.21--h8b25389_0'
params.echtvar_image = 'quay.io/biocontainers/echtvar@sha256:71cd0028f4aa9f7d012be3dc86b20e4df78fc5d8178d323c3c215a3f449a6244'
params.vep_image = 'ensemblorg/ensembl-vep:release_116.0'

process {
    errorStrategy = 'terminate'
    withName:INGEST_SAMPLE { maxForks = 32 }
    // variant_dim loading verifies exact target deltas; serialize it so two
    // sample loads cannot invalidate each other's verification window.
    withName:LOAD_VARIANTS { maxForks = 1 }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = "-v ${params.reference_dir}:${params.reference_dir}:ro"
    }
    singularity {
        singularity.enabled = true
        singularity.runOptions = "-B ${params.reference_dir}:${params.reference_dir}:ro"
    }
}

report { enabled = true; file = 'nextflow-report.html' }
timeline { enabled = true; file = 'nextflow-timeline.html' }
trace { enabled = true; file = 'nextflow-trace.tsv' }
dag { enabled = true; file = 'nextflow-dag.html' }
