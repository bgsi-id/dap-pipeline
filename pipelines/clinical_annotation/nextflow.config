manifest {
    name = 'DAP clinical annotation'
    version = '0.2.0'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.10.0'
}

params {
    reference_dir = '/reference'
    output_dir = 'results'
}

process {
    errorStrategy = 'terminate'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = "-v ${params.reference_dir}:${params.reference_dir}:ro"
    }

    singularity {
        singularity.enabled = true
        singularity.runOptions = "-B ${params.reference_dir}:${params.reference_dir}:ro"
    }
}

report {
    enabled = true
    file = 'nextflow-report.html'
}

timeline {
    enabled = true
    file = 'nextflow-timeline.html'
}

trace {
    enabled = true
    file = 'nextflow-trace.tsv'
}

dag {
    enabled = true
    file = 'nextflow-dag.html'
}
